{
  "name": "@edugis/cartogram",
  "version": "0.1.1",
  "description": "Turn GeoJSON into cartograms. Browser-compatible, dependency-free TypeScript.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker/cartogram.worker.d.ts",
      "import": "./dist/worker/cartogram.worker.js"
    }
  },
  "bin": {
    "cartogram": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "npm run build && node dist/cli.js",
    "harness": "vite",
    "bench": "npm run build && node bench/run.mjs",
    "app:dev": "vite",
    "app:build": "vite build",
    "app:preview": "vite preview --outDir dist-app",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "bench:go-cart": "npm run build && node bench/compare-go-cart.mjs"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.14",
    "@types/node": "^20.14.0",
    "go-cart-wasm": "^0.5.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.21",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "cartogram",
    "geojson",
    "map",
    "cartography",
    "visualization"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edugis-org/cartogram.git"
  },
  "homepage": "https://github.com/edugis-org/cartogram#readme",
  "bugs": {
    "url": "https://github.com/edugis-org/cartogram/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "EduGIS"
}
